<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
     THIS SHOULD ONLY BE USED FOR CHECKS THAT CAN'T BE TURNED OFF WITH
     SUPPRESSION COMMENTS OR @SuppressFBWarnings(..)
    -->
    <Match>
        <!-- Exclude generated sources   -->
        <Source name="~.*[\\/]build[\\/]generated[\\/]source.*" />
    </Match>

    <Match>
        <!-- Abstract base class with final subclasses - safe from finalizer attacks -->
        <Class name="io.github.creek.service.basic.kafka.streams.demo.internal.TopicDescriptors$TopicDescriptor" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
</FindBugsFilter>